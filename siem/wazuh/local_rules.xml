<!--
  Reglas de Wazuh para el log de seguridad de celeris-cache y para los archivos críticos de la demo.
  Nivel: 3 informativo, 5-8 sospechoso, 10-14 ataque probable.
  Las reglas de frecuencia agrupan por IP de origen: un intento suelto es ruido, una ráfaga es un ataque.
-->
<group name="celeris,">

  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">^celeris-cache$</field>
    <description>celeris-cache: evento de seguridad</description>
  </rule>

  <!-- Ciclo de vida -->
  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^startup$</field>
    <description>celeris-cache: el proxy arrancó</description>
    <group>service_start,</group>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^shutdown$</field>
    <description>celeris-cache: el proxy se detuvo</description>
    <group>service_stop,</group>
  </rule>

  <!-- Clientes no autorizados -->
  <rule id="100110" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^client_denied$</field>
    <description>celeris-cache: cliente no autorizado desde $(srcip)</description>
    <mitre><id>T1133</id></mitre>
    <group>access_denied,</group>
  </rule>

  <rule id="100111" level="10" frequency="5" timeframe="60" ignore="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_srcip />
    <description>celeris-cache: insistencia de un cliente no autorizado desde $(srcip)</description>
    <mitre><id>T1133</id></mitre>
    <group>access_denied,attack,</group>
  </rule>

  <!-- Puerto de administración -->
  <rule id="100120" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^admin_auth_failed$</field>
    <description>celeris-cache: token de administración rechazado desde $(srcip)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100121" level="12" frequency="5" timeframe="60" ignore="60">
    <if_matched_sid>100120</if_matched_sid>
    <same_srcip />
    <description>celeris-cache: fuerza bruta contra el token de administración desde $(srcip)</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,attack,</group>
  </rule>

  <!-- Escaneo de puertos a través del proxy -->
  <rule id="100130" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^port_blocked$</field>
    <description>celeris-cache: túnel bloqueado al puerto $(dstport) de $(host), desde $(srcip)</description>
    <mitre><id>T1046</id></mitre>
    <group>access_denied,</group>
  </rule>

  <rule id="100131" level="10" frequency="4" timeframe="60" ignore="60">
    <if_matched_sid>100130</if_matched_sid>
    <same_srcip />
    <description>celeris-cache: escaneo de puertos a través del proxy desde $(srcip)</description>
    <mitre><id>T1046</id></mitre>
    <group>recon,attack,</group>
  </rule>

  <!-- SSRF: usar el proxy para llegar a la red interna -->
  <rule id="100140" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^destination_blocked$</field>
    <description>celeris-cache: intento de llegar a la red interna ($(dstip)) desde $(srcip)</description>
    <mitre><id>T1090</id></mitre>
    <group>access_denied,ssrf,</group>
  </rule>

  <rule id="100141" level="12">
    <if_sid>100140</if_sid>
    <dstip>169.254.169.254</dstip>
    <description>celeris-cache: intento de leer los metadatos de la nube desde $(srcip)</description>
    <mitre><id>T1552.005</id></mitre>
    <group>access_denied,ssrf,attack,</group>
  </rule>

  <!-- Inundación -->
  <rule id="100150" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^rate_limited$</field>
    <description>celeris-cache: límite de peticiones superado por $(srcip)</description>
    <mitre><id>T1499</id></mitre>
    <group>flood,</group>
  </rule>

  <rule id="100151" level="10" frequency="20" timeframe="60" ignore="60">
    <if_matched_sid>100150</if_matched_sid>
    <same_srcip />
    <description>celeris-cache: inundación de peticiones desde $(srcip)</description>
    <mitre><id>T1499</id></mitre>
    <group>flood,attack,</group>
  </rule>

  <rule id="100152" level="8">
    <if_sid>100100</if_sid>
    <field name="event">^security_log_throttled$</field>
    <description>celeris-cache: el log de seguridad descarta líneas de $(reason) desde $(srcip)</description>
    <mitre><id>T1562.006</id></mitre>
    <group>flood,</group>
  </rule>

  <!-- Detecciones del propio proxy -->
  <rule id="100160" level="8">
    <if_sid>100100</if_sid>
    <field name="event">^detection$</field>
    <field name="reason">^host_mismatch$</field>
    <description>celeris-cache: el nombre declarado no coincide con el destino, desde $(srcip)</description>
    <mitre><id>T1090.004</id></mitre>
    <group>evasion,</group>
  </rule>

  <rule id="100161" level="6">
    <if_sid>100100</if_sid>
    <field name="event">^detection$</field>
    <field name="reason">^denied$</field>
    <description>celeris-cache: muchas respuestas 403 o 404 para $(srcip)</description>
    <mitre><id>T1595</id></mitre>
    <group>recon,</group>
  </rule>

  <rule id="100162" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^detection$</field>
    <field name="reason">^volume$</field>
    <description>celeris-cache: volumen inusual de tráfico de $(srcip)</description>
    <mitre><id>T1048</id></mitre>
    <group>exfiltration,</group>
  </rule>

  <!-- Alertas del panel -->
  <rule id="100170" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^alert_raised$</field>
    <description>celeris-cache: alerta del panel: $(reason)</description>
  </rule>

  <rule id="100171" level="13">
    <if_sid>100170</if_sid>
    <field name="reason">^corrupt_objects$</field>
    <description>celeris-cache: objeto de la caché alterado, posible envenenamiento</description>
    <mitre><id>T1565.001</id></mitre>
    <group>tampering,attack,</group>
  </rule>

  <rule id="100172" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^alert_resolved$</field>
    <description>celeris-cache: alerta del panel resuelta: $(reason)</description>
  </rule>

  <!-- Integridad de archivos críticos: 550 cambió, 553 se borró, 554 apareció -->
  <rule id="100180" level="14">
    <if_sid>550,553</if_sid>
    <field name="file">celeris-ca.key$</field>
    <description>celeris-cache: la clave de la CA fue modificada o borrada</description>
    <mitre><id>T1552.004</id></mitre>
    <group>syscheck,tampering,attack,</group>
  </rule>

  <rule id="100181" level="12">
    <if_sid>550,553</if_sid>
    <field name="file">celeris-ca.crt$</field>
    <description>celeris-cache: el certificado de la CA fue modificado o borrado</description>
    <mitre><id>T1553.004</id></mitre>
    <group>syscheck,tampering,attack,</group>
  </rule>

  <rule id="100182" level="10">
    <if_sid>550,553</if_sid>
    <field name="file">config.toml$</field>
    <description>celeris-cache: la configuración del proxy fue modificada</description>
    <mitre><id>T1562.001</id></mitre>
    <group>syscheck,tampering,</group>
  </rule>

  <rule id="100185" level="12">
    <if_sid>550,553</if_sid>
    <field name="file">admin.token$</field>
    <description>celeris-cache: el token de administración fue modificado o borrado</description>
    <mitre><id>T1098</id></mitre>
    <group>syscheck,tampering,attack,</group>
  </rule>

  <!-- Después de las reglas de cada archivo: recoge lo demás, como un archivo nuevo en la CA. -->
  <rule id="100186" level="10">
    <if_sid>550,553,554</if_sid>
    <field name="file">/var/celeris/ca/</field>
    <description>celeris-cache: cambio inesperado en la carpeta de la CA</description>
    <mitre><id>T1553.004</id></mitre>
    <group>syscheck,tampering,attack,</group>
  </rule>

  <!-- El nombre de un objeto es su hash: uno sustituido en dos revisiones aparece como borrado y luego nuevo. -->
  <rule id="100187" level="7">
    <if_sid>553</if_sid>
    <field name="file">/var/celeris/data/objects/</field>
    <description>celeris-cache: un objeto de la caché fue borrado</description>
    <mitre><id>T1485</id></mitre>
    <group>syscheck,tampering,</group>
  </rule>

  <!-- Es normal que el proxy guarde objetos nuevos. -->
  <rule id="100184" level="0">
    <if_sid>554</if_sid>
    <field name="file">/var/celeris/data/objects/</field>
    <description>celeris-cache: objeto nuevo en la caché</description>
  </rule>

  <!-- Hija de 100184: Wazuh evalúa primero las reglas de nivel 0, y una hermana nunca llegaría a activarse. -->
  <rule id="100188" level="12" timeframe="3600">
    <if_sid>100184</if_sid>
    <if_matched_sid>100187</if_matched_sid>
    <same_field>file</same_field>
    <description>celeris-cache: un objeto borrado de la caché volvió a aparecer</description>
    <mitre><id>T1565.001</id></mitre>
    <group>syscheck,tampering,attack,</group>
  </rule>

  <rule id="100183" level="12">
    <if_sid>550</if_sid>
    <field name="file">/var/celeris/data/objects/</field>
    <description>celeris-cache: un objeto de la caché cambió en disco</description>
    <mitre><id>T1565.001</id></mitre>
    <group>syscheck,tampering,attack,</group>
  </rule>

  <!-- Apache delante del panel: aquí aparece la IP real, porque el proxy solo ve a Apache (127.0.0.1). -->
  <rule id="100190" level="5">
    <if_sid>31101</if_sid>
    <id>^401$</id>
    <description>celeris-cache: token rechazado en $(url) desde $(srcip), vía Apache</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,apache,</group>
  </rule>

  <rule id="100191" level="12" frequency="5" timeframe="60" ignore="60">
    <if_matched_sid>100190</if_matched_sid>
    <same_srcip />
    <description>celeris-cache: fuerza bruta contra el panel desde $(srcip), vía Apache</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,apache,attack,</group>
  </rule>

  <rule id="100192" level="9">
    <if_sid>31103,31104,31105</if_sid>
    <description>celeris-cache: ataque web contra el panel desde $(srcip): $(url)</description>
    <mitre><id>T1190</id></mitre>
    <group>web,apache,attack,</group>
  </rule>

  <rule id="100193" level="10" frequency="8" timeframe="60" ignore="60">
    <if_matched_sid>31101</if_matched_sid>
    <same_srcip />
    <description>celeris-cache: exploración de rutas del panel desde $(srcip), vía Apache</description>
    <mitre><id>T1595.003</id></mitre>
    <group>recon,apache,attack,</group>
  </rule>

  <!--
    Ataques de red, a partir del registro del firewall de Windows (firewall_a_json.py).
    El proxy no los ve: un escaneo o una inundación no llegan a formar una petición HTTP.
  -->
  <rule id="100194" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">^celeris-firewall$</field>
    <description>celeris-cache: paquete recibido, según el firewall</description>
  </rule>

  <rule id="100195" level="0">
    <if_sid>100194</if_sid>
    <dstport>^3190$</dstport>
    <description>celeris-cache: paquete hacia el puerto 3190 del proxy</description>
  </rule>

  <rule id="100196" level="0">
    <if_sid>100194</if_sid>
    <field name="fw_protocol">^ICMP$</field>
    <description>celeris-cache: paquete ICMP</description>
  </rule>

  <rule id="100197" level="0">
    <if_sid>100194</if_sid>
    <field name="fw_protocol">^TCP$</field>
    <field name="fw_action">^DROP$</field>
    <field name="fw_flags" type="pcre2">^([FPU]+|-)$</field>
    <description>celeris-cache: paquete TCP sin SYN ni ACK</description>
  </rule>

  <!-- Nmap: sondea muchos puertos seguidos desde una IP -->
  <rule id="100198" level="12" frequency="15" timeframe="30" ignore="60">
    <if_matched_sid>100194</if_matched_sid>
    <same_srcip />
    <different_dstport />
    <description>celeris-cache: escaneo de puertos tipo Nmap desde $(srcip)</description>
    <mitre><id>T1046</id></mitre>
    <group>recon,attack,</group>
  </rule>

  <!-- Nmap con -sF, -sN o -sX: envía paquetes que ningún programa normal genera -->
  <rule id="100199" level="12" frequency="5" timeframe="30" ignore="60">
    <if_matched_sid>100197</if_matched_sid>
    <same_srcip />
    <description>celeris-cache: escaneo sigiloso tipo Nmap (FIN, NULL o Xmas) desde $(srcip)</description>
    <mitre><id>T1046</id></mitre>
    <group>recon,attack,</group>
  </rule>

  <!-- Nmap con -sV o -A contra 3190. Un navegador con muchas pestañas puede dar la misma ráfaga: por eso el nivel es menor -->
  <rule id="100200" level="7" frequency="12" timeframe="10" ignore="60">
    <if_matched_sid>100195</if_matched_sid>
    <same_srcip />
    <description>celeris-cache: ráfaga de conexiones al puerto 3190 desde $(srcip), posible sondeo con Nmap</description>
    <mitre><id>T1046</id></mitre>
    <group>recon,</group>
  </rule>

  <rule id="100201" level="12" frequency="100" timeframe="10" ignore="60">
    <if_matched_sid>100195</if_matched_sid>
    <same_srcip />
    <description>celeris-cache: posible DoS contra el puerto 3190 desde $(srcip)</description>
    <mitre><id>T1498</id></mitre>
    <group>dos,attack,</group>
  </rule>

  <!-- Umbral pensado para una red de laboratorio. En una red real, súbelo -->
  <rule id="100202" level="14" frequency="10" timeframe="10" ignore="60">
    <if_matched_sid>100195</if_matched_sid>
    <different_srcip />
    <description>celeris-cache: posible DDoS contra el puerto 3190, desde muchas IP distintas</description>
    <mitre><id>T1498</id></mitre>
    <group>dos,attack,</group>
  </rule>

  <!-- ICMP no usa puertos: estas dos reglas vigilan el equipo, no el puerto 3190 -->
  <rule id="100203" level="13">
    <if_sid>100196</if_sid>
    <field name="fw_size" type="pcre2">^\d{5,}$</field>
    <description>celeris-cache: posible ping de la muerte desde $(srcip): ICMP de $(fw_size) bytes</description>
    <mitre><id>T1499.004</id></mitre>
    <group>dos,attack,</group>
  </rule>

  <!-- Un ping normal envía uno por segundo. Un ping enorme llega partido en fragmentos: puede verse como esta ráfaga -->
  <rule id="100204" level="10" frequency="20" timeframe="10" ignore="60">
    <if_matched_sid>100196</if_matched_sid>
    <same_srcip />
    <description>celeris-cache: ráfaga de ICMP desde $(srcip), posible ping flood o ping de la muerte fragmentado</description>
    <mitre><id>T1498.001</id></mitre>
    <group>dos,attack,</group>
  </rule>

</group>
